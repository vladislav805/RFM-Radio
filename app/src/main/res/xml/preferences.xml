<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    app:title="@string/pref_activity_title">

    <PreferenceScreen
        app:icon="@drawable/ic_tuner"
        app:key="screen_tuner"
        app:title="@string/pref_header_tuner">

        <ListPreference
            app:defaultValue="1"
            app:dialogTitle="@string/pref_tuner_region"
            app:entries="@array/pref_tuner_region_entries"
            app:entryValues="@array/pref_tuner_region_values"
            app:icon="@drawable/ic_band"
            app:key="tuner_region"
            app:title="@string/pref_tuner_region"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:defaultValue="2"
            app:dialogTitle="@string/pref_tuner_spacing"
            app:entries="@array/pref_tuner_spacing_entries"
            app:entryValues="@array/pref_tuner_spacing_values"
            app:icon="@drawable/ic_step_freq"
            app:key="tuner_spacing"
            app:title="@string/pref_tuner_spacing"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:icon="@drawable/ic_stereo"
            app:key="tuner_stereo"
            app:summaryOff="@string/pref_tuner_stereo_off"
            app:summaryOn="@string/pref_tuner_stereo_on"
            app:title="@string/pref_tuner_stereo" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:icon="@drawable/ic_soft_mute"
            app:key="tuner_soft_mute"
            app:summaryOff="@string/pref_tuner_soft_mute_off"
            app:summaryOn="@string/pref_tuner_soft_mute_on"
            app:title="@string/pref_tuner_soft_mute" />

        <ListPreference
            app:defaultValue="0"
            app:dialogTitle="@string/pref_tuner_notch_filter"
            app:entries="@array/pref_tuner_notch_filter_entries"
            app:entryValues="@array/pref_tuner_notch_filter_values"
            app:icon="@drawable/ic_notch_filter"
            app:key="tuner_notch_filter"
            app:title="@string/pref_tuner_notch_filter"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            app:defaultValue="0"
            app:dialogMessage="@string/pref_tuner_antenna_message"
            app:dialogTitle="@string/pref_tuner_antenna"
            app:icon="@drawable/ic_antenna"
            app:key="tuner_antenna"
            app:title="@string/pref_tuner_antenna"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:icon="@drawable/ic_power"
            app:key="tuner_power_mode"
            app:summaryOff="@string/pref_tuner_power_mode_normal"
            app:summaryOn="@string/pref_tuner_power_mode_low"
            app:title="@string/pref_tuner_power_mode" />

    </PreferenceScreen>

    <PreferenceScreen
        app:icon="@drawable/ic_rds"
        app:key="screen_rds"
        app:title="@string/pref_header_rds">

        <Preference
            app:enabled="false"
            app:iconSpaceReserved="false"
            app:key="tuner_rds_description"
            app:summary="@string/pref_tuner_rds_description" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:icon="@drawable/ic_rds"
            app:key="rds_auto_af"
            app:summaryOff="@string/pref_tuner_rds_auto_af_disabled"
            app:summaryOn="@string/pref_tuner_rds_auto_afenabled"
            app:title="@string/pref_tuner_rds_auto_af" />

    </PreferenceScreen>

    <PreferenceScreen
        app:icon="@drawable/ic_record_on"
        app:key="screen_recording"
        app:title="@string/pref_header_recording">

        <EditTextPreference
            app:defaultValue="@string/pref_recording_path_value"
            app:dialogMessage="@string/pref_recording_path_name_description"
            app:dialogTitle="@string/pref_recording_path_title"
            app:icon="@drawable/ic_directory"
            app:key="recording_directory"
            app:title="@string/pref_recording_path_title"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            app:defaultValue="@string/pref_recording_name_value"
            app:dialogMessage="@string/pref_recording_path_name_description"
            app:dialogTitle="@string/pref_recording_name_title"
            app:icon="@drawable/ic_file_music"
            app:key="recording_filename"
            app:title="@string/pref_recording_name_title"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:defaultValue="0"
            app:dialogTitle="@string/pref_recording_format_title"
            app:entries="@array/pref_recording_format_entries"
            app:entryValues="@array/pref_recording_format_values"
            app:icon="@drawable/ic_recording_format"
            app:key="recording_mode"
            app:title="@string/pref_recording_format_title"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:icon="@drawable/ic_pre_roll"
            app:key="recording_save_past"
            app:summary="@string/pref_recording_save_past_summary"
            app:title="@string/pref_recording_save_past" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:icon="@drawable/ic_notifications"
            app:key="recording_show_notify"
            app:summary="@string/pref_recording_show_notify_summary"
            app:title="@string/pref_recording_show_notify" />

    </PreferenceScreen>

    <PreferenceScreen
        app:icon="@drawable/ic_settings"
        app:key="screen_app"
        app:title="@string/pref_header_app">

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:icon="@drawable/ic_autostart"
            app:key="app_auto_startup"
            app:summaryOff="@string/pref_auto_startup_disabled"
            app:summaryOn="@string/pref_app_auto_startup_enabled"
            app:title="@string/pref_app_auto_startup" />

        <ListPreference
            app:defaultValue="3"
            app:dialogTitle="@string/pref_app_favorites_columns"
            app:entries="@array/pref_app_favorites_columns"
            app:entryValues="@array/pref_app_favorites_columns"
            app:icon="@drawable/ic_grid_view"
            app:key="app_favorites_columns"
            app:title="@string/pref_app_favorites_columns"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:defaultValue="system"
            app:dialogTitle="@string/pref_app_theme"
            app:entries="@array/pref_app_theme_entries"
            app:entryValues="@array/pref_app_theme_values"
            app:icon="@drawable/ic_theme"
            app:key="app_theme"
            app:title="@string/pref_app_theme"
            app:useSimpleSummaryProvider="true" />

    </PreferenceScreen>

    <PreferenceScreen
        app:icon="@drawable/ic_notifications"
        app:key="screen_notifications"
        app:title="@string/pref_header_notifications">

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:icon="@drawable/ic_ps_name"
            app:key="notification_show_ps"
            app:summaryOff="@string/pref_notification_show_ps_disabled"
            app:summaryOn="@string/pref_notification_show_ps_enabled"
            app:title="@string/pref_notification_show_ps" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:icon="@drawable/ic_seek_arrows"
            app:key="notification_seek_by_favorites"
            app:summaryOff="@string/pref_notification_seek_by_favorites_disabled"
            app:summaryOn="@string/pref_notification_seek_by_favorites_enabled"
            app:title="@string/pref_notification_seek_by_favorites" />

    </PreferenceScreen>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:key="info"
        app:title="@string/pref_header_info">

        <Preference
            app:icon="@drawable/ic_info"
            app:key="pref_about"
            app:title="@string/menu_about" />

        <Preference
            app:icon="@drawable/ic_update"
            app:key="pref_info_version"
            app:title="@string/pref_info_version_title" />

    </PreferenceCategory>

</PreferenceScreen>
