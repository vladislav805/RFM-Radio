<resources xmlns:tools="http://schemas.android.com/tools">

	<!-- Default Material 3 DayNight theme for all activities -->
	<style name="AppCompatTheme" parent="Theme.Material3.DayNight.NoActionBar">
		<item name="colorPrimary">@color/rfm_md_primary</item>
		<item name="colorOnPrimary">@color/rfm_md_on_primary</item>
		<item name="colorPrimaryContainer">@color/rfm_md_primary_container</item>
		<item name="colorOnPrimaryContainer">@color/rfm_md_on_primary_container</item>
		<item name="colorSecondary">@color/rfm_md_secondary</item>
		<item name="colorOnSecondary">@color/rfm_md_on_secondary</item>
		<item name="colorSecondaryContainer">@color/rfm_md_secondary_container</item>
		<item name="colorOnSecondaryContainer">@color/rfm_md_on_secondary_container</item>
		<item name="colorTertiary">@color/rfm_md_tertiary</item>
		<item name="colorErrorContainer">@color/rfm_md_error_container</item>
		<item name="colorOnErrorContainer">@color/rfm_md_on_error_container</item>
		<item name="android:windowBackground">?android:attr/colorBackground</item>
		<item name="android:statusBarColor">@android:color/transparent</item>
		<item name="android:navigationBarColor">@android:color/transparent</item>
		<item name="android:windowLightStatusBar">@bool/rfm_light_system_bars</item>
		<item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@bool/rfm_light_system_bars</item>
		<item name="actionBarTheme">@style/ThemeOverlay.Material3.Dark.ActionBar</item>
	</style>

	<style name="DialogActivityTheme" parent="Theme.Material3.DayNight.Dialog">
		<item name="windowNoTitle">true</item>
		<item name="android:windowBackground">@android:color/transparent</item>
		<item name="android:backgroundDimEnabled">true</item>
	</style>

	<!-- Compact Material 3 IconButton for transport deck & headers -->
	<style name="RfmIconButtonTonal" parent="Widget.Material3.Button.IconButton.Filled.Tonal">
		<item name="android:insetTop">0dp</item>
		<item name="android:insetBottom">0dp</item>
		<item name="android:insetLeft">0dp</item>
		<item name="android:insetRight">0dp</item>
		<item name="cornerRadius">16dp</item>
	</style>

	<style name="RfmIconButtonStandard" parent="Widget.Material3.Button.IconButton">
		<item name="android:insetTop">0dp</item>
		<item name="android:insetBottom">0dp</item>
		<item name="android:insetLeft">0dp</item>
		<item name="android:insetRight">0dp</item>
	</style>
</resources>
