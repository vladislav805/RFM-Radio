<resources>

	<!-- Default style for all activities (DayNight adaptive) -->
	<style name="AppCompatTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
		<item name="colorPrimary">@color/rfm_surface</item>
		<item name="colorPrimaryDark">@color/rfm_bg</item>
		<item name="colorAccent">@color/rfm_accent</item>
		<item name="android:windowBackground">@color/rfm_bg</item>
		<item name="android:colorBackground">@color/rfm_bg</item>
		<item name="android:statusBarColor">@color/rfm_bg</item>
		<item name="android:navigationBarColor">@color/rfm_bg</item>
		<item name="android:textColorPrimary">@color/rfm_text_primary</item>
		<item name="android:textColorSecondary">@color/rfm_text_secondary</item>
	</style>

	<style name="DialogActivityTheme" parent="Theme.AppCompat.DayNight.Dialog">
		<item name="windowNoTitle">true</item>
		<item name="android:windowBackground">@android:color/transparent</item>
		<item name="android:backgroundDimEnabled">true</item>
	</style>

	<!-- Frequency TextView and reflection -->
	<style name="Frequency">
		<item name="android:lineSpacingMultiplier">1</item>
		<item name="android:lineSpacingExtra">0sp</item>
		<item name="android:gravity">end</item>
		<item name="android:textSize">52sp</item>
		<item name="android:textColor">@color/rfm_text_primary</item>
	</style>

	<style name="RDS_PS">
		<item name="android:fontFamily">monospace</item>
		<item name="android:textSize">18sp</item>
		<item name="android:textColor">@color/rfm_text_primary</item>
		<item name="android:gravity">start|center_vertical</item>
	</style>

	<style name="RDS_RT">
		<item name="android:textSize">14sp</item>
		<item name="android:textColor">@color/rfm_text_secondary</item>
		<item name="android:gravity">start|top</item>
	</style>
	<style name="RDS_PTY">
		<item name="android:textSize">12sp</item>
		<item name="android:textColor">@color/rfm_text_secondary</item>
		<item name="android:gravity">start|center_vertical</item>
	</style>
</resources>
