<resources xmlns:tools="http://schemas.android.com/tools">

	<!-- Default Material 3 DayNight theme for all activities -->
	<style name="AppCompatTheme" parent="Theme.Material3.DayNight.NoActionBar">
		<item name="colorPrimary">@color/rfm_md_primary</item>
		<item name="colorOnPrimary">@color/rfm_md_on_primary</item>
		<item name="colorPrimaryContainer">@color/rfm_md_primary_container</item>
		<item name="colorOnPrimaryContainer">@color/rfm_md_on_primary_container</item>
		<item name="colorSecondary">@color/rfm_md_secondary</item>
		<item name="colorOnSecondary">@color/rfm_md_on_secondary</item>
		<item name="colorSecondaryContainer">@color/rfm_md_secondary_container</item>
		<item name="colorOnSecondaryContainer">@color/rfm_md_on_secondary_container</item>
		<item name="colorTertiary">@color/rfm_md_tertiary</item>
		<item name="colorErrorContainer">@color/rfm_md_error_container</item>
		<item name="colorOnErrorContainer">@color/rfm_md_on_error_container</item>
		<item name="android:windowBackground">?android:attr/colorBackground</item>
		<item name="android:statusBarColor">@android:color/transparent</item>
		<item name="android:navigationBarColor">@android:color/transparent</item>
		<item name="android:windowLightStatusBar">@bool/rfm_light_system_bars</item>
		<item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@bool/rfm_light_system_bars</item>
		<item name="actionBarTheme">@style/ThemeOverlay.Material3.Dark.ActionBar</item>
		<item name="preferenceTheme">@style/RfmPreferenceTheme</item>
	</style>

	<style name="RfmPreferenceTheme" parent="PreferenceThemeOverlay">
		<item name="preferenceStyle">@style/RfmPreference</item>
		<item name="preferenceScreenStyle">@style/RfmPreferenceScreen</item>
		<item name="dialogPreferenceStyle">@style/RfmDialogPreference</item>
		<item name="editTextPreferenceStyle">@style/RfmEditTextPreference</item>
		<item name="switchPreferenceCompatStyle">@style/RfmSwitchPreference</item>
	</style>

	<style name="RfmPreference" parent="Preference.Material">
		<item name="android:layout">@layout/pref_row</item>
	</style>

	<style name="RfmPreferenceScreen" parent="Preference.PreferenceScreen.Material">
		<item name="android:layout">@layout/pref_row</item>
	</style>

	<style name="RfmDialogPreference" parent="Preference.DialogPreference.Material">
		<item name="android:layout">@layout/pref_row</item>
	</style>

	<style name="RfmEditTextPreference" parent="Preference.DialogPreference.EditTextPreference.Material">
		<item name="android:layout">@layout/pref_row</item>
	</style>

	<style name="RfmSwitchPreference" parent="Preference.SwitchPreferenceCompat.Material">
		<item name="android:layout">@layout/pref_row</item>
		<item name="android:widgetLayout">@layout/pref_widget_material_switch</item>
	</style>

	<style name="DialogActivityTheme" parent="Theme.Material3.DayNight.Dialog">
		<item name="windowNoTitle">true</item>
		<item name="android:windowBackground">@android:color/transparent</item>
		<item name="android:backgroundDimEnabled">true</item>
	</style>

	<!-- Compact Material 3 IconButton for transport deck & headers -->
	<style name="RfmIconButtonTonal" parent="Widget.Material3.Button.IconButton.Filled.Tonal">
		<item name="android:insetTop">0dp</item>
		<item name="android:insetBottom">0dp</item>
		<item name="android:insetLeft">0dp</item>
		<item name="android:insetRight">0dp</item>
		<item name="cornerRadius">16dp</item>
		<item name="iconGravity">textStart</item>
		<item name="iconPadding">0dp</item>
		<item name="iconSize">@dimen/icon_size_transport</item>
	</style>

	<style name="RfmIconButtonStandard" parent="Widget.Material3.Button.IconButton">
		<item name="android:insetTop">0dp</item>
		<item name="android:insetBottom">0dp</item>
		<item name="android:insetLeft">0dp</item>
		<item name="android:insetRight">0dp</item>
		<item name="iconGravity">textStart</item>
		<item name="iconPadding">0dp</item>
		<item name="iconSize">@dimen/icon_size_action</item>
		<item name="iconTint">?attr/colorOnSurfaceVariant</item>
	</style>

	<style name="RfmIconButtonStandard.Toolbar">
		<item name="cornerRadius">@dimen/icon_button_corner_radius</item>
	</style>

	<!-- Segmented Material 3 grouped list card shapes -->
	<style name="RfmListCardTop" parent="">
		<item name="cornerFamily">rounded</item>
		<item name="cornerSizeTopLeft">16dp</item>
		<item name="cornerSizeTopRight">16dp</item>
		<item name="cornerSizeBottomLeft">4dp</item>
		<item name="cornerSizeBottomRight">4dp</item>
	</style>

	<style name="RfmListCardMiddle" parent="">
		<item name="cornerFamily">rounded</item>
		<item name="cornerSize">4dp</item>
	</style>

	<style name="RfmListCardBottom" parent="">
		<item name="cornerFamily">rounded</item>
		<item name="cornerSizeTopLeft">4dp</item>
		<item name="cornerSizeTopRight">4dp</item>
		<item name="cornerSizeBottomLeft">16dp</item>
		<item name="cornerSizeBottomRight">16dp</item>
	</style>
</resources>
