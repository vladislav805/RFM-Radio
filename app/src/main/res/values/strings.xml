	<string name="pref_tuner_rds_description">RDS - Radio Data System\nDisplay of radio-related information transmitted by radio stations.\nPS - Program Service (usually name of station)\nRT - Radio Text (usually name of current track, info about station)\nAF - Alternative Frequencies (list of frequencies on which the same station is broadcasting in neighboring regions )\nPTY - Program TYpe (genre of station)</string>
	<string name="pref_not_supported_by_device">Not supported by device</string>
	<string name="pref_header_recording">Recording</string>
	<string name="pref_recording_path_title">Subdirectory for saving</string>
	<string name="pref_recording_path_value" translatable="false">$y-$m-$d</string>
	<string name="pref_recording_name_title">Filename</string>
	<string name="pref_recording_name_value" translatable="false">FM-$h$i$s-$f</string>
	<string name="pref_recording_path_name_description" tools:ignore="TypographyDashes">Available variables:\n$y - year\n$m - month\n$d - day of month\n$h - hour\n$i - minute\n$s - second\n$f - frequency (e.g., 103.4 MHz = 1034)\n$r - random number 10000-99999\nRecordings are stored inside Music/RFM-Recordings.\nThe directory value must stay relative to that root.\nExample:\nDirectory: station/$y-$m-$d -> Music/RFM-Recordings/station/2020-01-27\nFilename: Rec-$h_$i_$s_$f -> Rec_23_01_49_0906.wav</string>
	<string name="pref_recording_format_title">Recording format</string>
	<string name="pref_recording_format_wav">WAV PCM 16bit</string>
	<string name="pref_recording_format_mp3_128">MP3 128kbps</string>
	<string name="pref_recording_format_mp3_192">MP3 192kbps</string>
	<string name="pref_recording_format_opus_96">Opus 96 kbps</string>
	<string name="pref_recording_save_past">Record previous 5 seconds</string>
	<string name="pref_recording_save_past_summary">Include the five seconds before Record was pressed</string>
	<string name="pref_recording_save_past_warning_title">Enable recording history?</string>
	<string name="pref_recording_save_past_warning_message">This keeps FM audio capture active while the radio is playing, which increases battery use. Android will show its recording privacy indicator even when no file is being recorded. This indicator is an Android limitation.</string>
	<string name="pref_recording_show_notify">Show notifications</string>
