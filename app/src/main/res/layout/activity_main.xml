<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingTop="4dp"
    tools:context=".activity.MainActivity">

    <!-- 1. TOP MATERIAL 3 APP BAR -->
    <LinearLayout
        android:id="@+id/top_status_bar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="?attr/colorOnSurface"
            android:textSize="22sp" />

        <!-- Record toggle + live timer Material pill -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_record"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:clickable="true"
            android:contentDescription="@string/menu_record"
            android:focusable="true"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:cardCornerRadius="17dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:id="@+id/record_dot"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:alpha="0.3"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_rfm_rec_dot" />

                <TextView
                    android:id="@+id/record_duration_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="monospace"
                    android:text="@string/record_badge_idle"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- AF indicator Material pill (clickable to show AF frequencies dialog) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/af_badge_card"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:cardCornerRadius="17dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/af_badge"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:minWidth="44dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/rds_af_label"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Settings / overflow trigger Material IconButton (full 48dp touch target) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_settings_menu"
            style="@style/RfmIconButtonStandard"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/menu_settings"
            app:icon="@drawable/ic_settings"
            app:iconSize="@dimen/icon_size_app_bar" />
    </LinearLayout>

    <!-- 2 & 3. REUSABLE TUNER HEADER + RT/RT+ ROW -->
    <include
        android:id="@+id/tuner_display"
        layout="@layout/include_tuner_display"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_status_bar" />

    <!-- 4. EDGE-TO-EDGE DRUM FREQUENCY DIAL -->
    <com.vlad805.fmradio.view.FrequencyDialView
        android:id="@+id/frequency_seek"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_marginTop="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tuner_display" />

    <!-- 5. ONE-HANDED MATERIAL 3 TRANSPORT DECK (SEEK / STEP / POWER) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/transport_deck"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="14dp"
        android:clipChildren="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/frequency_seek">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ctl_seek_down"
            style="@style/RfmIconButtonTonal"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/seek_down"
            android:visibility="gone"
            app:icon="@drawable/ic_rfm_seek_prev"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ctl_go_down"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ctl_go_down"
            style="@style/RfmIconButtonTonal"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/jump_down"
            android:visibility="gone"
            app:icon="@drawable/ic_rfm_step_prev"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ctl_toggle"
            app:layout_constraintStart_toEndOf="@+id/ctl_seek_down"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ctl_toggle"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:contentDescription="@string/power_toggle_description"
            android:elevation="4dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="22dp"
            app:icon="@drawable/ic_rfm_power"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/ctl_toggle_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="6dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorSize="26dp"
            app:layout_constraintBottom_toBottomOf="@+id/ctl_toggle"
            app:layout_constraintEnd_toEndOf="@+id/ctl_toggle"
            app:layout_constraintStart_toStartOf="@+id/ctl_toggle"
            app:layout_constraintTop_toTopOf="@+id/ctl_toggle"
            app:trackThickness="3dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ctl_go_up"
            style="@style/RfmIconButtonTonal"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="10dp"
            android:contentDescription="@string/jump_up"
            android:visibility="gone"
            app:icon="@drawable/ic_rfm_step_next"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ctl_seek_up"
            app:layout_constraintStart_toEndOf="@+id/ctl_toggle"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ctl_seek_up"
            style="@style/RfmIconButtonTonal"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/seek_up"
            android:visibility="gone"
            app:icon="@drawable/ic_rfm_seek_next"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ctl_go_up"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 6. FAVORITES STATION CONSOLE (SURFACE-COLORED PANEL, FILLING REMAINING HEIGHT) -->
    <com.vlad805.fmradio.view.FavoritesView
        android:id="@+id/favorite_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/transport_deck" />

    <!-- 7. EXPANDING RT+ OVERLAY CARD (ANCHORED TO @id/tuner_display, DRAWN OVER DIAL & CONTROLS) -->
    <include
        layout="@layout/include_rt_plus_overlay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="-40dp"
        android:layout_marginEnd="14dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tuner_display"
        app:layout_constraintVertical_bias="0" />

</androidx.constraintlayout.widget.ConstraintLayout>
