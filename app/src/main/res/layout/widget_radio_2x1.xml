<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_container"
    android:orientation="vertical"
    android:padding="1dp">

    <!-- Top section: Frequency + MHz and Station (opens MainActivity) -->
    <LinearLayout
        android:id="@+id/widget_info_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_widget_2x1_top"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_frequency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="106.3"
                android:textColor="@color/widget_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="MHz"
                android:textColor="@color/widget_text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_station"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            tools:text="RECORD" />
    </LinearLayout>

    <!-- Bottom section: Signal bars (left) and Power button (right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_widget_2x1_bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="5dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <include
            layout="@layout/widget_signal_bars"
            android:layout_width="wrap_content"
            android:layout_height="14dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp">

            <ImageButton
                android:id="@+id/widget_btn_power"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_widget_btn_power_on"
                android:contentDescription="@string/cd_power_toggle"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_rfm_power"
                android:tint="@color/widget_btn_power_on_icon" />

            <ProgressBar
                android:id="@+id/widget_power_progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/widget_btn_power_on_icon"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
