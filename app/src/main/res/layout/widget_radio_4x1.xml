<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_container"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <!-- Left info area (opens MainActivity) -->
    <LinearLayout
        android:id="@+id/widget_info_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Frequency + MHz + Signal bars -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_frequency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="106.3"
                android:textColor="@color/widget_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="MHz"
                android:textColor="@color/widget_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <include
                layout="@layout/widget_signal_bars"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="2dp" />
        </LinearLayout>

        <!-- Station / Status -->
        <TextView
            android:id="@+id/widget_station"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp"
            tools:text="RECORD" />

        <!-- Clickable REC pill under PS -->
        <include
            layout="@layout/widget_rec_pill"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Right playback controls -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_btn_prev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_widget_btn_tonal"
            android:contentDescription="@string/cd_seek_prev"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_rfm_seek_prev"
            android:tint="@color/widget_text_primary" />

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">

            <ImageButton
                android:id="@+id/widget_btn_power"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_widget_btn_power_on"
                android:contentDescription="@string/cd_power_toggle"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_rfm_power"
                android:tint="@color/widget_btn_power_on_icon" />

            <ProgressBar
                android:id="@+id/widget_power_progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/widget_btn_power_on_icon"
                android:visibility="gone" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/widget_btn_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_widget_btn_tonal"
            android:contentDescription="@string/cd_seek_next"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_rfm_seek_next"
            android:tint="@color/widget_text_primary" />
    </LinearLayout>

</LinearLayout>
