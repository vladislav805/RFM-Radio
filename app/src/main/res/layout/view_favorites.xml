<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Material3.CardView.Elevated"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
    app:cardCornerRadius="24dp"
    app:cardElevation="1dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <!-- Header Row: Material Tonal List Selector + Add Station + Reorder + Manage Lists -->
        <LinearLayout
            android:id="@+id/favorite_header_bar"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- List Selector Tonal Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/favorite_list_selector"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:contentDescription="@string/favorites_select_list"
                android:ellipsize="end"
                android:gravity="center_vertical|start"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:minHeight="0dp"
                android:paddingStart="14dp"
                android:paddingTop="0dp"
                android:paddingEnd="10dp"
                android:paddingBottom="0dp"
                android:textSize="13sp"
                app:cornerRadius="17dp"
                app:icon="@drawable/ic_rfm_chevron_down"
                app:iconGravity="end"
                app:iconSize="18dp"
                tools:text="default" />

            <Space
                android:layout_width="6dp"
                android:layout_height="1dp" />

            <!-- Add current frequency to favorites -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/favorite_add_button"
                style="@style/RfmIconButtonTonal"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@string/favorites_add_current"
                app:icon="@drawable/ic_rfm_add"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="20dp" />

            <Space
                android:layout_width="6dp"
                android:layout_height="1dp" />

            <!-- Edit / Reorder mode toggle -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/favorite_edit_toggle"
                style="@style/RfmIconButtonTonal"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@string/favorites_edit"
                app:icon="@drawable/ic_preset_order_toggle"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="18dp" />

            <Space
                android:layout_width="6dp"
                android:layout_height="1dp" />

            <!-- Open FavoriteListsActivity (Manage lists) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/favorite_button"
                style="@style/RfmIconButtonTonal"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@string/favorites_manage_lists"
                app:icon="@drawable/ic_rfm_lists"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="18dp" />
        </LinearLayout>

        <!-- Grid of favorite stations (scrolls inside this box if many stations, main screen stays fixed) -->
        <com.vlad805.fmradio.view.FavoritesRecyclerView
            android:id="@+id/favorite_recycler"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:clickable="true"
            android:clipToPadding="false"
            android:focusable="true"
            android:overScrollMode="never"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/favorite_header_bar"
            tools:listitem="@layout/favorite_station_item" />

        <TextView
            android:id="@+id/favorite_empty_hint"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/favorites_empty_hint"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/favorite_recycler"
            app:layout_constraintEnd_toEndOf="@id/favorite_recycler"
            app:layout_constraintStart_toStartOf="@id/favorite_recycler"
            app:layout_constraintTop_toTopOf="@id/favorite_recycler"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
