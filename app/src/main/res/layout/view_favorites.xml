<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_favorites_panel"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp">

    <!-- Compact List Selector Pill: ★ default ▾ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/favorite_list_selector"
        android:layout_width="0dp"
        android:layout_height="34dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        android:clickable="true"
        android:contentDescription="@string/favorites_select_list"
        android:focusable="true"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="17dp"
        app:cardElevation="0dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@id/favorite_edit_toggle"
        app:layout_constraintEnd_toStartOf="@+id/favorite_scan_button"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/favorite_edit_toggle"
        app:strokeWidth="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/favorite_list_selector_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/imageView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="default" />

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="@dimen/icon_size_small"
                android:layout_height="@dimen/icon_size_small"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_rfm_chevron_down"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/favorite_list_selector_text"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="?attr/colorOnSurfaceVariant" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Scan for stations -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/favorite_scan_button"
        style="@style/RfmIconButtonStandard.Toolbar"
        android:layout_width="@dimen/icon_button_size"
        android:layout_height="@dimen/icon_button_size"
        android:contentDescription="@string/menu_scan_stations"
        app:icon="@drawable/ic_search"
        app:layout_constraintBottom_toBottomOf="@id/favorite_edit_toggle"
        app:layout_constraintEnd_toStartOf="@id/favorite_add_button"
        app:layout_constraintTop_toTopOf="@id/favorite_edit_toggle" />

    <!-- Add current station to favorites -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/favorite_add_button"
        style="@style/RfmIconButtonStandard.Toolbar"
        android:layout_width="@dimen/icon_button_size"
        android:layout_height="@dimen/icon_button_size"
        android:contentDescription="@string/favorites_add_station"
        app:icon="@drawable/ic_rfm_bookmark_add"
        app:layout_constraintBottom_toBottomOf="@id/favorite_edit_toggle"
        app:layout_constraintEnd_toStartOf="@id/favorite_edit_toggle"
        app:layout_constraintTop_toTopOf="@id/favorite_edit_toggle" />

    <!-- Edit / Reorder mode toggle -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/favorite_edit_toggle"
        style="@style/RfmIconButtonStandard.Toolbar"
        android:layout_width="@dimen/icon_button_size"
        android:layout_height="@dimen/icon_button_size"
        android:contentDescription="@string/favorites_edit"
        app:icon="@drawable/ic_rfm_edit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Grid of favorite stations -->
    <com.vlad805.fmradio.view.FavoritesRecyclerView
        android:id="@+id/favorite_recycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clickable="true"
        android:fadingEdgeLength="@dimen/favorites_fading_edge"
        android:focusable="true"
        android:overScrollMode="never"
        android:requiresFadingEdge="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/favorite_edit_toggle"
        tools:listitem="@layout/favorite_station_item" />

    <TextView
        android:id="@+id/favorite_empty_hint"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/favorites_empty_hint"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/favorite_recycler"
        app:layout_constraintEnd_toEndOf="@id/favorite_recycler"
        app:layout_constraintStart_toStartOf="@id/favorite_recycler"
        app:layout_constraintTop_toTopOf="@id/favorite_recycler"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
