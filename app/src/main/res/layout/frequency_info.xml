<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- 1. SYMMETRIC 3-COLUMN TUNER HEADER (FLAT ConstraintLayout) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tuner_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="132dp"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- CENTER: LARGE FREQUENCY + MHz -->
        <TextView
            android:id="@+id/frequency_mhz"
            android:layout_width="134dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurface"
            android:textSize="44sp"
            app:layout_constraintBottom_toTopOf="@+id/frequency_unit"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="102.8" />

        <TextView
            android:id="@+id/frequency_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/mhz_unit"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/frequency_mhz"
            app:layout_constraintStart_toStartOf="@+id/frequency_mhz"
            app:layout_constraintTop_toBottomOf="@+id/frequency_mhz" />

        <!-- TOP LEFT: SIGNAL + STEREO/MONO -->
        <com.vlad805.fmradio.view.SignalStrengthView
            android:id="@+id/signal_strength"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/signal_strength_indicator"
            app:layout_constraintBottom_toBottomOf="@+id/frequency_pi_label"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/frequency_pi" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/stereo_mono_card"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:cardCornerRadius="11dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/signal_strength"
            app:layout_constraintStart_toEndOf="@+id/signal_strength"
            app:layout_constraintTop_toTopOf="@+id/signal_strength"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/stereo_mono"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/mono_mode_label"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- BOTTOM LEFT: PS -->
        <TextView
            android:id="@+id/frequency_ps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:gravity="start|bottom"
            android:maxLines="2"
            android:minLines="2"
            android:text="@string/rds_placeholder"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/frequency_ps_label"
            app:layout_constraintEnd_toStartOf="@+id/frequency_mhz"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/signal_strength"
            app:layout_constraintVertical_bias="1"
            tools:text="RADIO ROCK" />

        <TextView
            android:id="@+id/frequency_ps_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:text="PS"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="HardcodedText" />

        <!-- TOP RIGHT: PI -->
        <TextView
            android:id="@+id/frequency_pi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:gravity="end"
            android:maxLines="1"
            android:text="@string/rds_placeholder"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/frequency_mhz"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="7201" />

        <TextView
            android:id="@+id/frequency_pi_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="@string/rds_pi_prefix"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/frequency_pi" />

        <!-- BOTTOM RIGHT: PTY -->
        <TextView
            android:id="@+id/frequency_pty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="14dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="end|bottom"
            android:maxLines="2"
            android:minLines="2"
            android:text="@string/rds_placeholder"
            android:textColor="?attr/colorOnSurface"
            android:textSize="13sp"
            app:layout_constraintBottom_toTopOf="@+id/frequency_pty_label"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/frequency_mhz"
            app:layout_constraintTop_toBottomOf="@+id/frequency_pi_label"
            app:layout_constraintVertical_bias="1"
            tools:text="Popular Music (Pop)" />

        <TextView
            android:id="@+id/frequency_pty_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:text="@string/rds_pty_prefix"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. COMPACT BORDERLESS RT / RT+ TRIGGER ROW (FIXED 2 LINES) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rt_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tuner_header">

        <!-- Raw RadioText (Fixed 2 lines height) -->
        <TextView
            android:id="@+id/frequency_rt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="start|top"
            android:lineSpacingExtra="2dp"
            android:lines="2"
            android:maxLines="2"
            android:minLines="2"
            android:text="@string/rds_rt_empty"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_toggle_rt_plus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Appears only when station broadcasts RT+ tags -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_toggle_rt_plus"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/frequency_rt"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp"
            tools:visibility="visible">

            <TextView
                android:id="@+id/btn_toggle_rt_plus_text"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/rds_rt_plus_label"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp" />
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 3. EDGE-TO-EDGE DRUM FREQUENCY DIAL -->
    <com.vlad805.fmradio.view.FrequencyDialView
        android:id="@+id/frequency_seek"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_marginTop="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rt_card" />
</androidx.constraintlayout.widget.ConstraintLayout>
