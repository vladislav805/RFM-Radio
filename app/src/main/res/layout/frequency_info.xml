<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- 1. SYMMETRIC 3-COLUMN TUNER HEADER (FLAT ConstraintLayout) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tuner_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="132dp"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- CENTER: LARGE FREQUENCY + MHz -->
        <TextView
            android:id="@+id/frequency_mhz"
            android:layout_width="134dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurface"
            android:textSize="44sp"
            app:layout_constraintBottom_toTopOf="@+id/frequency_unit"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="102.8" />

        <TextView
            android:id="@+id/frequency_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/mhz_unit"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/frequency_mhz"
            app:layout_constraintStart_toStartOf="@+id/frequency_mhz"
            app:layout_constraintTop_toBottomOf="@+id/frequency_mhz" />

        <!-- TOP LEFT: SIGNAL + STEREO/MONO -->
        <com.vlad805.fmradio.view.SignalStrengthView
            android:id="@+id/signal_strength"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/signal_strength_indicator"
            app:layout_constraintBottom_toBottomOf="@+id/frequency_pi_label"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/frequency_pi" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/stereo_mono_card"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:cardCornerRadius="11dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/signal_strength"
            app:layout_constraintStart_toEndOf="@+id/signal_strength"
            app:layout_constraintTop_toTopOf="@+id/signal_strength"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/stereo_mono"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/mono_mode_label"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- BOTTOM LEFT: PS -->
        <TextView
            android:id="@+id/frequency_ps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:gravity="start|bottom"
            android:maxLines="2"
            android:minLines="2"
            android:text="@string/rds_placeholder"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/frequency_ps_label"
            app:layout_constraintEnd_toStartOf="@+id/frequency_mhz"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/signal_strength"
            app:layout_constraintVertical_bias="1"
            tools:text="RADIO ROCK" />

        <TextView
            android:id="@+id/frequency_ps_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:text="PS"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="HardcodedText" />

        <!-- TOP RIGHT: PI -->
        <TextView
            android:id="@+id/frequency_pi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:gravity="end"
            android:maxLines="1"
            android:text="@string/rds_placeholder"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/frequency_mhz"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="7201" />

        <TextView
            android:id="@+id/frequency_pi_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="@string/rds_pi_prefix"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/frequency_pi" />

        <!-- BOTTOM RIGHT: PTY -->
        <TextView
            android:id="@+id/frequency_pty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="14dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="end|bottom"
            android:maxLines="2"
            android:minLines="2"
            android:text="@string/rds_placeholder"
            android:textColor="?attr/colorOnSurface"
            android:textSize="13sp"
            app:layout_constraintBottom_toTopOf="@+id/frequency_pty_label"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/frequency_mhz"
            app:layout_constraintTop_toBottomOf="@+id/frequency_pi_label"
            app:layout_constraintVertical_bias="1"
            tools:text="Popular Music (Pop)" />

        <TextView
            android:id="@+id/frequency_pty_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:text="@string/rds_pty_prefix"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. EDGE-TO-EDGE DRUM FREQUENCY DIAL -->
    <com.vlad805.fmradio.view.FrequencyDialView
        android:id="@+id/frequency_seek"
        android:layout_width="0dp"
        android:layout_height="68dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tuner_header" />

    <!-- 3. RT / RT+ MATERIAL 3 CARD (FIXED HEIGHT, NEVER JUMPS) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/rt_card"
        style="@style/Widget.Material3.CardView.Elevated"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="14dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
        app:cardCornerRadius="20dp"
        app:cardElevation="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/frequency_seek"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/rt_card_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="RadioText"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                app:layout_constraintBottom_toBottomOf="@+id/rt_mode_toggle_container"
                app:layout_constraintEnd_toStartOf="@+id/rt_mode_toggle_container"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/rt_mode_toggle_container"
                tools:ignore="HardcodedText" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/rt_mode_toggle_container"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                app:checkedButton="@id/btn_mode_rt"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mode_rt"
                    style="@style/RfmSegmentedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/rds_rt_label" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mode_rt_plus"
                    style="@style/RfmSegmentedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/rds_rt_plus_label" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rt_mode_toggle_container">

                <!-- Mode A: Raw RadioText (Fixed 3 lines height) -->
                <TextView
                    android:id="@+id/frequency_rt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="start|top"
                    android:lineSpacingExtra="2dp"
                    android:lines="3"
                    android:maxLines="3"
                    android:minLines="3"
                    android:text="@string/rds_rt_empty"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp" />

                <!-- Mode B: Structured RT+ (Artist / Title / Album) -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/rt_plus_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/rt_plus_artist_label"
                        android:layout_width="64dp"
                        android:layout_height="22dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center_vertical"
                        android:text="@string/rds_rt_plus_artist"
                        android:textAllCaps="true"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="10sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/rt_plus_artist_value"
                        android:layout_width="0dp"
                        android:layout_height="22dp"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:text="@string/rds_placeholder"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/rt_plus_artist_label"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/rt_plus_title_label"
                        android:layout_width="64dp"
                        android:layout_height="22dp"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center_vertical"
                        android:text="@string/rds_rt_plus_title"
                        android:textAllCaps="true"
                        android:textColor="?attr/colorSecondary"
                        android:textSize="10sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/rt_plus_artist_label" />

                    <TextView
                        android:id="@+id/rt_plus_title_value"
                        android:layout_width="0dp"
                        android:layout_height="22dp"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:text="@string/rds_placeholder"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/rt_plus_title_label"
                        app:layout_constraintTop_toBottomOf="@+id/rt_plus_artist_value" />

                    <TextView
                        android:id="@+id/rt_plus_album_label"
                        android:layout_width="64dp"
                        android:layout_height="22dp"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center_vertical"
                        android:text="@string/rds_rt_plus_album"
                        android:textAllCaps="true"
                        android:textColor="?attr/colorTertiary"
                        android:textSize="10sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/rt_plus_title_label" />

                    <TextView
                        android:id="@+id/rt_plus_album_value"
                        android:layout_width="0dp"
                        android:layout_height="22dp"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:text="@string/rds_placeholder"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/rt_plus_album_label"
                        app:layout_constraintTop_toBottomOf="@+id/rt_plus_title_value" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
