<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rfm_card"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <!-- Top Row: Large Frequency + PS & PI -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Frequency Value + MHz (Fixed width container so 99.9 vs 100.00 never shifts PS/PI) -->
        <LinearLayout
            android:layout_width="184dp"
            android:layout_height="wrap_content"
            android:gravity="bottom|start"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/frequency_mhz"
                android:layout_width="144dp"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="end"
                android:includeFontPadding="false"
                android:letterSpacing="-0.03"
                android:maxLines="1"
                android:textColor="@color/rfm_text_primary"
                android:textSize="42sp"
                android:textStyle="bold"
                tools:text="101.7" />

            <TextView
                android:id="@+id/frequency_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginBottom="5dp"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="@string/mhz_unit"
                android:textColor="@color/rfm_accent"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <!-- Right column: PS badge & PI chip -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end|center_vertical"
            android:orientation="vertical">

            <!-- PS (Program Service) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:background="@drawable/bg_rfm_inset"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="PS"
                    android:textColor="@color/rfm_accent"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/frequency_ps"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="@string/rds_placeholder"
                    android:textColor="@color/rfm_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- PI (Program ID + Country) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_rfm_inset"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="@string/rds_pi_prefix"
                    android:textColor="@color/rfm_text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/frequency_pi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="@string/rds_placeholder"
                    android:textColor="@color/rfm_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Second Row: PTY / Status Banner + RT / RT+ Segmented Toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- PTY / Tuner Status box (Fixed single line) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_rfm_inset"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/frequency_pty_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="@string/rds_pty_prefix"
                android:textColor="@color/rfm_amber"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/frequency_pty"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/rds_placeholder"
                android:textColor="@color/rfm_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <!-- RT / RT+ Mode Switcher -->
        <LinearLayout
            android:id="@+id/rt_mode_toggle_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/bg_rfm_inset"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="2dp">

            <TextView
                android:id="@+id/btn_mode_rt"
                android:layout_width="38dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_rfm_pill_active"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="@string/rds_rt_label"
                android:textColor="@color/rfm_accent"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_mode_rt_plus"
                android:layout_width="42dp"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="@string/rds_rt_plus_label"
                android:textColor="@color/rfm_text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Third Row: RT / RT+ Display Container (Fixed height for raw RT so 1..3 lines never jump) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_rfm_inset"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <!-- Mode A: Raw RadioText (Fixed 3 lines height) -->
        <TextView
            android:id="@+id/frequency_rt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="start|top"
            android:lineSpacingExtra="2dp"
            android:lines="3"
            android:maxLines="3"
            android:minLines="3"
            android:text="@string/rds_rt_empty"
            android:textColor="@color/rfm_text_primary"
            android:textSize="13sp" />

        <!-- Mode B: Structured RT+ (Artist / Title / Album) -->
        <LinearLayout
            android:id="@+id/rt_plus_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Artist Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="@string/rds_rt_plus_artist"
                    android:textAllCaps="true"
                    android:textColor="@color/rfm_accent"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/rt_plus_artist_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/rds_placeholder"
                    android:textColor="@color/rfm_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Title Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="@string/rds_rt_plus_title"
                    android:textAllCaps="true"
                    android:textColor="@color/rfm_emerald"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/rt_plus_title_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/rds_placeholder"
                    android:textColor="@color/rfm_text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Album Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="@string/rds_rt_plus_album"
                    android:textAllCaps="true"
                    android:textColor="@color/rfm_amber"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/rt_plus_album_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/rds_placeholder"
                    android:textColor="@color/rfm_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
