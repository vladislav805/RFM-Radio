<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/recordings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true"
    tools:context=".activity.RecordingsActivity">

    <!-- MAIN BROWSER CONTENT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/recordings_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="@string/recordings_title"
            app:titleTextColor="?attr/colorOnSurface" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recordings_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="88dp" />

            <LinearLayout
                android:id="@+id/recordings_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:alpha="0.45"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_file_music"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/recordings_empty_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/recordings_empty"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- SEMI-TRANSPARENT SCRIM BEHIND EXPANDED DRAWER -->
    <View
        android:id="@+id/player_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <!-- PERSISTENT BOTTOM SHEET: MINI-PLAYER (COLLAPSED) + PLAYER DRAWER (EXPANDED) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/player_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        app:behavior_hideable="true"
        app:behavior_peekHeight="76dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- COLLAPSED: MINI-PLAYER BAR -->
            <LinearLayout
                android:id="@+id/mini_player_bar"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_pref_icon"
                    android:importantForAccessibility="no"
                    android:padding="8dp"
                    android:src="@drawable/ic_file_music"
                    app:tint="?attr/colorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/mini_player_path"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="start"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11sp"
                        tools:text="2026-11-27" />

                    <TextView
                        android:id="@+id/mini_player_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp"
                        tools:text="FM-153131-1053.opus" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mini_player_play_pause"
                    style="@style/RfmIconButtonTonal"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/toggle_play_pause"
                    app:icon="@drawable/ic_rfm_play" />
            </LinearLayout>

            <!-- EXPANDED: FULL PLAYER DRAWER -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/expanded_player_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0"
                android:clickable="true"
                android:focusable="true"
                android:paddingBottom="28dp"
                android:visibility="invisible">

                <!-- Drag pill -->
                <View
                    android:id="@+id/player_drag_handle"
                    android:layout_width="36dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="10dp"
                    android:alpha="0.4"
                    android:background="?attr/colorOnSurfaceVariant"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Drawer Header: Collapse | Title + Path | More Menu -->
                <LinearLayout
                    android:id="@+id/player_header"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/player_drag_handle">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_player_collapse"
                        style="@style/RfmIconButtonStandard"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/recordings_collapse_player"
                        app:icon="@drawable/ic_rfm_chevron_down" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/player_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="16sp"
                            tools:text="FM-153131-1053.opus" />

                        <TextView
                            android:id="@+id/player_path"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="start"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp"
                            tools:text="2026-11-27" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_player_more"
                        style="@style/RfmIconButtonStandard"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/recordings_more_actions"
                        app:icon="@drawable/ic_more_vert" />
                </LinearLayout>

                <!-- Reused RadioUI Display (visible when RFM1 metadata is present) -->
                <include
                    android:id="@+id/player_tuner_display"
                    layout="@layout/include_tuner_display"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/player_header" />

                <!-- Fallback card when file has no RFM1 metadata -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/player_no_rds_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginEnd="16dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/player_header"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:alpha="0.6"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_file_music"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/player_no_rds_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center"
                            android:text="@string/recordings_no_rds_metadata"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <androidx.constraintlayout.widget.Barrier
                    android:id="@+id/player_display_bottom_barrier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:barrierDirection="bottom"
                    app:constraint_referenced_ids="player_tuner_display,player_no_rds_card" />

                <!-- Waveform Seekbar -->
                <com.vlad805.fmradio.view.WaveformView
                    android:id="@+id/player_waveform"
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/player_display_bottom_barrier" />

                <!-- Time Labels (fixed width prevents requestLayout() from snapping BottomSheet while dragging) -->
                <TextView
                    android:id="@+id/player_time_current"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="6dp"
                    android:fontFamily="monospace"
                    android:gravity="start"
                    android:text="00:00"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/player_waveform"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/player_time_total"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:text="00:00"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/player_waveform"
                    tools:ignore="HardcodedText" />

                <!-- Transport Controls: Prev | Play/Pause | Next -->
                <LinearLayout
                    android:id="@+id/player_transport_controls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/player_time_current">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_player_prev"
                        style="@style/RfmIconButtonTonal"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:contentDescription="@string/recordings_prev"
                        app:cornerRadius="26dp"
                        app:icon="@drawable/ic_rfm_seek_prev" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_player_play_pause"
                        style="@style/Widget.Material3.Button.IconButton.Filled"
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:contentDescription="@string/toggle_play_pause"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="34dp"
                        app:icon="@drawable/ic_rfm_play"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="30dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_player_next"
                        style="@style/RfmIconButtonTonal"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:contentDescription="@string/recordings_next"
                        app:cornerRadius="26dp"
                        app:icon="@drawable/ic_rfm_seek_next" />
                </LinearLayout>

                <!-- Floating RT+ overlay over waveform & transport -->
                <include
                    layout="@layout/include_rt_plus_overlay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="-40dp"
                    android:layout_marginEnd="14dp"
                    app:layout_constrainedHeight="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/player_tuner_display"
                    app:layout_constraintVertical_bias="0" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
